// Models
class Checklist {
  final int id;
  final String? userId;
  final DateTime date;
  String? signaturePath;

  Checklist({
    required this.id,
    this.userId,
    required this.date,
    this.signaturePath,
  });
}

class Task {
  final int id;
  final int checklistId;
  final String description;
  bool isCompleted;
  String? note;

  Task({
    required this.id,
    required this.checklistId,
    required this.description,
    this.isCompleted = false,
    this.note,
  });
}

