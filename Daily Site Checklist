}

// Database Helper
class DatabaseHelper {
  static Database? _database;
  static DatabaseHelper? _instance;

  factory DatabaseHelper() => _instance ??= DatabaseHelper._();

  DatabaseHelper._();

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDB();
    return _database!;
  }

  Future<Database> _initDB() async {
    Directory dir = await getApplicationDocumentsDirectory();
    String path = join(dir.path, 'checklist.db');
    return await openDatabase(
      path,
      version: 1,
      onCreate: (db, version) async {
        await db.execute('''
          CREATE TABLE checklists (
            id INTEGER PRIMARY KEY,
            userId TEXT,
            date TEXT,
            signaturePath TEXT
          )
        ''');
        await db.execute('''
          CREATE TABLE tasks (
            id INTEGER PRIMARY KEY,
            checklistId INTEGER,
            description TEXT,
            isCompleted INTEGER,
            note TEXT,
            FOREIGN KEY (checklistId) REFERENCES checklists (id)
          )
        ''');
        await db.execute('''
          CREATE TABLE task_images (
            id INTEGER PRIMARY KEY,
            taskId INTEGER,
            imagePath TEXT,
            FOREIGN KEY (taskId) REFERENCES tasks (id)
          )
        ''');
      },
    );
  }

  Future<int> insertChecklist(Checklist checklist) async {
    final db = await database;
    return await db.insert('checklists', {
      'userId': checklist.userId,
      'date': checklist.date.toIso8601String().split('T')[0],
      'signaturePath': checklist.signaturePath,
    });
  }

  Future<List<Checklist>> getChecklists() async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query('checklists');
    return List.generate(maps.length, (i) {
      return Checklist(
        id: maps[i]['id'],
        userId: maps[i]['userId'],
        date: DateTime.parse(maps[i]['date']),
        signaturePath: maps[i]['signaturePath'],
      );
    });
  }

  Future<int> insertTask(Task task) async {
    final db = await database;
    return await db.insert('tasks', {
      'checklistId': task.checklistId,
      'description': task.description,
      'isCompleted': task.isCompleted ? 1 : 0,
      'note': task.note,
    });
  }

  Future<List<Task>> getTasksForChecklist(int checklistId) async {
    final db = await database;
    final List<Map<String, dynamic>> maps = await db.query(
      'tasks',
      where: 'checklistId = ?',
      whereArgs: [checklistId],
    );
    return List.generate(maps.length, (i) {
      return Task(
        id: maps[i]['id'],
        checklistId: maps[i]['checklistId'],
        description: maps[i]['description'],
        isCompleted: maps[i]['isCompleted'] == 1,
        note: maps[i]['note'],
      );
    });
  }

  // Additional methods for update, delete, etc.
}

// Auth Service
class AuthService {
  final FirebaseAuth _auth = FirebaseAuth.instance;

  Future<User?> signIn(String email, String password) async {
    try {
      UserCredential result = await _auth.signInWithEmailAndPassword(email: email, password: password);
      return result.user;
    } catch (e) {
      print(e);
      return null;
    }
  }

  Future<User?> signUp(String email, String password) async {
    try {
      UserCredential result = await _auth.createUserWithEmailAndPassword(email: email, password: password);
      return result.user;
    } catch (e) {
      print(e);
      return null;
    }
  }

  Future<void> signOut() async {
    await _auth.signOut();
  }
}

// Notification Service
class NotificationService {
  final FlutterLocalNotificationsPlugin notifications = FlutterLocalNotificationsPlugin();

  Future<void> initialize() async {
    const AndroidInitializationSettings initializationSettingsAndroid =
        AndroidInitializationSettings('app_icon');
    final InitializationSettings initializationSettings = InitializationSettings(
      android: initializationSettingsAndroid,
    );
    await notifications.initialize(initializationSettings);
  }

  Future<void> scheduleDailyNotification() async {
    const AndroidNotificationDetails androidPlatformChannelSpecifics =
        AndroidNotificationDetails('checklist_channel', 'Daily Checklist Reminder',
            importance: Importance.max,
            priority: Priority.high,
            showWhen: false);
    const NotificationDetails platformChannelSpecifics =
        NotificationDetails(android: androidPlatformChannelSpecifics);
    await notifications.periodic(
      const Duration(days: 1),
      0,
      const Notification(
        title: 'Daily Checklist Reminder',
        body: 'Please complete your daily site checklist.',
      ),
      platformChannelSpecifics,
      payload: 'checklist_reminder',
    );
  }
}

